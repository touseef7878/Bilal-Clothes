# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Email (Google SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your normal Gmail password
# Generate at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=youremail@gmail.com

# Owner receives weekly summary emails
OWNER_EMAIL=owner@gmail.com

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_BUSINESS_NUMBER=+923001234567

# ── Cron job protection ───────────────────────────────────────────────────────
# Any random secret string — add same value in Vercel env vars
CRON_SECRET=your-random-secret-string

# ── Payment Gateway (Safepay) — fill when merchant account is ready ───────────
SAFEPAY_PUBLIC_KEY=your-safepay-public-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret
